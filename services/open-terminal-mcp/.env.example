# =============================================================================
# open-terminal-mcp/.env.example
# Copiar a .env — usado solo por "make build" (login + push a registry.404labo.net).
# El Makefile lo carga con "-include .env" (sin "export" global).
# =============================================================================

# Mismo usuario/contraseña que el resto de microservicios del clúster — un
# único usuario compartido para pull y push por ahora (ver
# docs/22-mejoras-futuras.md para separar lectura/escritura más adelante).
# Credenciales en Vaultwarden ("Docker Registry (registry.404labo.net)").
REGISTRY_URI=registry.404labo.net
REGISTRY_USER=CHANGE_ME_registry_user
REGISTRY_PASSWORD=CHANGE_ME_registry_password
