# =============================================================================
# apikey-service/.env.example
# Copiar a .env — usado por "make run", "make build" y "make sonar"/"make sonar-check".
# El Makefile lo carga con "-include .env" (sin "export" global): cada target
# que necesita una variable la pasa explícita en su propio comando — así
# "make test" no hereda APIKEY_DATABASE_URL y sigue aislado con su sqlite de
# prueba (conftest.py usa os.environ.setdefault(), que un "export" global
# pisaría).
# =============================================================================

# --- make run (apunta a una base de datos de prueba, no a producción salvo que lo hagas a propósito) ---
APIKEY_DATABASE_URL=postgresql+asyncpg://apikeys:CHANGE_ME@192.168.1.174:5432/apikeys
APIKEY_ADMIN_TOKEN=CHANGE_ME_admin_token_de_prueba
APIKEY_PORT=8090

# --- Logging (Loguru) ----------------------------------------------------
APIKEY_LOG_LEVEL=INFO
# json = logs estructurados (recomendado en producción, ver docs/04-servicios-comunes.md,
# sección promtail) | text = formato legible en consola, más cómodo en local.
APIKEY_LOG_FORMAT=json

# --- make build (login + push a registry.home.arpa) ---
# Mismo usuario/contraseña que markitdown-service/whisper-service — un único
# usuario compartido para pull y push por ahora (ver docs/22-mejoras-futuras.md
# para separar lectura/escritura más adelante). Credenciales en Vaultwarden
# ("Docker Registry (registry.home.arpa)").
REGISTRY_URI=registry.home.arpa
REGISTRY_USER=CHANGE_ME_registry_user
REGISTRY_PASSWORD=CHANGE_ME_registry_password

# --- make sonar / sonar-check ---
# pysonar usa la librería "requests", que valida TLS contra el bundle de
# certifi, no contra el almacén de certificados del sistema — por eso hace
# falta fijar REQUESTS_CA_BUNDLE a la CA interna del clúster (instalada a
# nivel de sistema tras generate-cert.sh — ver docs/15-ca-interna.md) para que
# "https://sonarqube.home.arpa" valide igual que en curl/el navegador.
SONAR_HOST_URL=https://sonarqube.home.arpa
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Token de análisis: SonarQube UI -> My Account -> Security -> Generate Tokens
# (ver docs/09-instalacion-pi3-sonarqube.md)
SONAR_TOKEN=CHANGE_ME_sonar_analysis_token
