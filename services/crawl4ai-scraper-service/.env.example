# =============================================================================
# Configuración del microservicio de scraping (Crawl4AI + FastAPI)
# Copia este fichero como ".env" y ajusta los valores según tu entorno.
# =============================================================================

# --- Aplicación ---------------------------------------------------------
APP_NAME="Crawl4AI Scraper Service"
APP_ENV=local                     # local | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Logging (Loguru) ----------------------------------------------------
LOG_LEVEL=INFO                    # TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text                   # text | json
LOG_FILE_PATH=                    # p.ej. logs/app.log ; vacío = solo salida por consola
LOG_ROTATION="10 MB"              # tamaño/tiempo de rotación del fichero de log
LOG_RETENTION="7 days"            # retención de ficheros de log rotados

# --- Concurrencia y timeouts ---------------------------------------------
# Nº máximo de scrapes ejecutándose simultáneamente (backpressure con semáforo).
MAX_CONCURRENT_SCRAPES=12
# Nº máximo de navegadores DEDICADOS simultáneos — solo aplica a peticiones
# cuyo "params" pida stealth_mode/undetected_browser distinto de este .env
# (lanzan un Chromium aparte, no el navegador compartido). Bajo a propósito:
# cada uno es un proceso Chromium completo, varios a la vez pueden agotar
# la RAM en nodos pequeños (Raspberry Pi).
MAX_CONCURRENT_DEDICATED_BROWSERS=2
# Timeout máximo (segundos) para completar un scrape individual.
SCRAPE_TIMEOUT_SECONDS=60
# Timeout máximo (segundos) que una petición puede esperar para adquirir un
# "slot" del semáforo antes de devolver 503. 0 = esperar indefinidamente.
SEMAPHORE_ACQUIRE_TIMEOUT_SECONDS=90

# --- Crawl4AI: navegador --------------------------------------------------
CRAWLER_HEADLESS=true
CRAWLER_VERBOSE=false
# Tiempo máximo (ms) que Crawl4AI espera a que la página cargue.
CRAWLER_PAGE_TIMEOUT_MS=60000
# Momento de espera del ciclo de vida de la página: domcontentloaded | load | networkidle
CRAWLER_WAIT_UNTIL=domcontentloaded
# Nº de páginas servidas por el navegador compartido antes de que Crawl4AI lo
# recicle (lanza uno nuevo y drena/cierra el anterior). Sin esto, páginas que
# Crawl4AI no logra cerrar tras un timeout/crash quedan como procesos
# Chromium huérfanos que se acumulan indefinidamente. 0 = deshabilitado, no usar.
# Bajado a 15 (antes 50): con 50 no evitó un leak real de 452MB->5,7GB en ~1h
# bajo una tanda con muchos bloqueos anti-bot (docs/10-instalacion-pi4-utils.md).
MAX_PAGES_BEFORE_RECYCLE=15

# --- Anti-bot / anti-detección (todos activables/desactivables por separado) --
# Stealth mode: parchea navigator.webdriver, fingerprint de canvas/WebGL, etc.
ENABLE_STEALTH_MODE=false

# Undetected Browser Adapter de Crawl4AI (evasión avanzada, más lento).
ENABLE_UNDETECTED_BROWSER=false

# Magic Mode: simulación de comportamiento humano, gestión de cookies/popups,
# retardos aleatorios (magic + simulate_user + override_navigator).
ENABLE_MAGIC_MODE=false

# Proxy (para inyectar un proxy residencial en dominios problemáticos).
ENABLE_PROXY=false
PROXY_SERVER=                     # p.ej. http://proxy.example.com:8080
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Reintentos / fallback ante bloqueo (Cloudflare/DataDome/Akamai, etc.) ---
# Nº de rondas de reintento cuando Crawl4AI detecta un bloqueo. 0 = sin reintentos.
MAX_RETRIES=2

# --- Markdown --------------------------------------------------------------
# Longitud mínima (nº de palabras) de un bloque de texto para conservarlo.
MARKDOWN_WORD_COUNT_THRESHOLD=10

# --- make build (login + push a registry.home.arpa) ---
# Mismo usuario/contraseña que apikey-service/markitdown-service/whisper-service
# — un único usuario compartido para pull y push por ahora (ver
# docs/22-mejoras-futuras.md para separar lectura/escritura más adelante).
# Credenciales en Vaultwarden ("Docker Registry (registry.home.arpa)").
REGISTRY_URI=registry.home.arpa
REGISTRY_USER=CHANGE_ME_registry_user
REGISTRY_PASSWORD=CHANGE_ME_registry_password

# --- make sonar / sonar-check ---
# pysonar usa la librería "requests", que valida TLS contra el bundle de
# certifi, no contra el almacén de certificados del sistema — por eso hace
# falta fijar REQUESTS_CA_BUNDLE a la CA interna del clúster (instalada a
# nivel de sistema tras generate-cert.sh — ver docs/15-ca-interna.md) para que
# "https://sonarqube.home.arpa" valide igual que en curl/el navegador.
SONAR_HOST_URL=https://sonarqube.home.arpa
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Token de análisis: SonarQube UI -> My Account -> Security -> Generate Tokens
# (ver docs/09-instalacion-pi3-sonarqube.md)
SONAR_TOKEN=CHANGE_ME_sonar_analysis_token
