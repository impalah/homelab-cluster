# =============================================================================
# .gitignore — epub2pdf-service
# =============================================================================

# Entorno virtual de uv — se recrea con "uv sync" / "make test", nunca se versiona
.venv/

# uv.lock SÍ se versiona a propósito (reproducibilidad del build) — no lo añadas aquí

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*$py.class

# Empaquetado (hatchling / uv build)
build/
dist/
*.egg-info/
*.egg

# Tests y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Otros cachés de herramientas (si se usan alguna vez en local)
.mypy_cache/
.ruff_cache/

# pysonar (make sonar / sonar-check) — directorio de trabajo local del análisis
.scannerwork/
.sonar/

# Datos de prueba locales (docker-compose.yml monta ./data/input y ./data/output)
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Variables de entorno reales — solo .env.example se versiona
.env

# Editores / SO
.DS_Store
*.swp
