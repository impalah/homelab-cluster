# =============================================================================
# pi-utils/.env.example
# Copiar a /srv/homelab/pi-utils/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- n8n-aux ---
N8N_AUX_ENCRYPTION_KEY=CHANGE_ME_32_char_random_hex_key_aux
N8N_AUX_BASIC_AUTH_ACTIVE=true
N8N_AUX_BASIC_AUTH_USER=admin
N8N_AUX_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_aux_password
N8N_AUX_HOST=n8n-aux.home.arpa
N8N_AUX_PORT=5679
N8N_AUX_PROTOCOL=https
N8N_AUX_WEBHOOK_URL=https://n8n-aux.home.arpa/
GENERIC_TIMEZONE=Europe/Madrid

# --- RSSHub ---
RSSHUB_ACCESS_KEY=CHANGE_ME_rsshub_access_key
RSSHUB_CACHE_EXPIRE=300

# --- markitdown-service ---
MARKITDOWN_PORT=8001
MARKITDOWN_LOG_LEVEL=INFO

# --- crawl4ai-scraper-service ---
# Ver docs/10-instalacion-pi4-utils.md y services/crawl4ai-scraper-service/README.md
# para el detalle de cada variable. Valores por defecto (anti-bot desactivado)
# — ajustar según necesidad real del nodo.
CRAWL4AI_APP_ENV=production
CRAWL4AI_LOG_FORMAT=json
CRAWL4AI_MAX_CONCURRENT_SCRAPES=12
# Navegadores Chromium DEDICADOS simultáneos — solo para peticiones cuyo
# "params" pida stealth_mode/undetected_browser distinto de este .env. Bajo
# a propósito, cada uno es un proceso Chromium completo (RAM limitada en
# esta Pi).
CRAWL4AI_MAX_CONCURRENT_DEDICATED_BROWSERS=2
CRAWL4AI_SCRAPE_TIMEOUT_SECONDS=60
CRAWL4AI_SEMAPHORE_ACQUIRE_TIMEOUT_SECONDS=90
CRAWL4AI_CRAWLER_HEADLESS=true
CRAWL4AI_CRAWLER_WAIT_UNTIL=domcontentloaded
# Anti-bot/anti-detección — cada uno independiente, "false" por defecto en
# la plantilla. Actívalos solo si de verdad los necesitas (más lento).
CRAWL4AI_ENABLE_STEALTH_MODE=false
CRAWL4AI_ENABLE_UNDETECTED_BROWSER=false
CRAWL4AI_ENABLE_MAGIC_MODE=false
CRAWL4AI_MAX_RETRIES=2
CRAWL4AI_MARKDOWN_WORD_COUNT_THRESHOLD=10

# --- Vaultwarden ---
# Token del panel /admin (https://vaultwarden.home.arpa/admin) — gestión de
# usuarios, diagnóstico, borrado de cuentas, etc. Guardarlo aparte, no en el
# propio Vaultwarden (obvio, pero conviene decirlo).
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_vaultwarden_admin_token
# Dejar en "true" SOLO durante la instalación inicial, para poder crear tu
# primera cuenta. En cuanto la tengas creada, cambiar a "false" y reiniciar
# el contenedor — ver docs/10-instalacion-pi4-utils.md paso 3.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# --- Zona horaria ---
TZ=Europe/Madrid
