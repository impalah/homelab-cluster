# =============================================================================
# retaco/.env.example
# Copiar a /srv/homelab/retaco/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- PostgreSQL (postgres-main) — cuenta de administración del servidor ---
# Superusuario del servidor Postgres. NO la usa ninguna app directamente —
# es solo para tareas de gestión (crear nuevas bases de datos con
# shared/scripts/create-postgres-db.sh, backups, etc.).
POSTGRES_ADMIN_USER=dbadmin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_strong_postgres_admin_password

# --- PostgreSQL — base de datos y usuario propios de n8n ---
# Aislados: n8n solo puede ver/tocar su propia base de datos, no las de
# otros proyectos que añadas más adelante (ver docs/05-instalacion-retaco.md).
# Si vienes de migrar ryzen, usa los MISMOS valores que tenía
# ryzen/.env → N8N_DB_NAME/N8N_DB_USER/N8N_DB_PASSWORD, para que n8n-main
# siga viendo su base de datos existente sin tener que reconfigurar nada.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_strong_n8n_db_password

# --- n8n-main ---
# Si vienes de migrar ryzen: usa los MISMOS valores que tenía ryzen/.env,
# especialmente N8N_ENCRYPTION_KEY — cambiarla haría ILEGIBLES todas las
# credenciales ya guardadas en workflows existentes (irreversible, ver
# docs/05-instalacion-retaco.md).
N8N_ENCRYPTION_KEY=CHANGE_ME_32_char_random_hex_key_here
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_HOST=n8n.home.arpa
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.home.arpa/
GENERIC_TIMEZONE=Europe/Madrid

# --- Qdrant ---
# Si vienes de migrar ryzen, usa los MISMOS valores que tenía ryzen/.env,
# para no tener que actualizar credenciales en n8n ni en ningún otro cliente
# — ver docs/05-instalacion-retaco.md sección de migración.
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key_32chars
QDRANT_READONLY_KEY=CHANGE_ME_qdrant_readonly_key

# --- Registry (registro Docker privado) ---
# Solo el HTTP secret va aquí — el usuario/contraseña de docker login vive
# en /srv/homelab/retaco/registry/auth/htpasswd (bcrypt, no en texto plano
# en ningún .env). Ver docs/05-instalacion-retaco.md.
REGISTRY_HTTP_SECRET=CHANGE_ME_random_hex_secret

# --- epub2pdf-service / pdf2chunks-service ---
# Todas opcionales, con default razonable en docker-compose.yml si no se
# definen aquí — solo hace falta tocarlas para cambiar el comportamiento por
# defecto. Ver docs/05-instalacion-retaco.md sección 5.4 y el README de cada
# servicio (services/epub2pdf-service/, services/pdf2chunks-service/).
EPUB2PDF_LOG_LEVEL=INFO
EPUB2PDF_CONVERSION_TIMEOUT_SECONDS=300
PDF2CHUNKS_LOG_LEVEL=INFO
PDF2CHUNKS_OCR_CHAR_THRESHOLD=20
PDF2CHUNKS_OCR_LANGUAGE=eng
PDF2CHUNKS_CHUNK_SIZE_TOKENS=400
PDF2CHUNKS_CHUNK_OVERLAP_RATIO=0.15
PDF2CHUNKS_CHUNKING_STRATEGY=fixed_size
PDF2CHUNKS_OUTPUT_FORMAT=json

# --- open-webui — ver docs/23-bifrost-gateway-llm.md sección de migración ---
# Si vienes de migrar ryzen: usa el MISMO valor que tenía ryzen/.env ->
# OPENWEBUI_SECRET_KEY, para no invalidar las sesiones de los usuarios ya
# creados (solo aplica si además migras webui.db — con Postgres como base,
# lo normal es partir de usuarios nuevos, ver más abajo).
OPENWEBUI_SECRET_KEY=CHANGE_ME_openwebui_secret_key
# Virtual key de Bifrost (pi-sonar) — la misma que se generó en
# docs/23-bifrost-gateway-llm.md, NO una credencial de AWS.
BIFROST_VIRTUAL_KEY=CHANGE_ME_bifrost_virtual_key
# Contraseña del usuario "openwebui" en postgres-main — creada con
# create-postgres-db.sh postgres-main <admin> openwebui openwebui.
# Guardar también en Vaultwarden (no hay forma automática de escribir en el
# vault de un usuario — E2E, el servidor nunca conoce la contraseña maestra).
OPENWEBUI_DB_PASSWORD=CHANGE_ME_openwebui_db_password
# QDRANT_API_KEY ya está definida más arriba (sección Qdrant) — open-webui
# reutiliza esa misma variable, no hace falta duplicarla.

# --- open-terminal-mcp — ver docs/24-open-terminal-mcp.md ---
# Secreto puramente interno: lo usa el propio proceso MCP para llamar a su
# API REST interna (open_terminal/mcp_server.py), NINGÚN cliente externo
# (Open WebUI, n8n) lo necesita ni lo conoce — el acceso externo real lo
# protege apikey-service en pi-dns (X-Api-Key), no esta variable. Generar con
# "openssl rand -hex 32", igual que el resto de secretos del clúster.
OPEN_TERMINAL_API_KEY=CHANGE_ME_open_terminal_internal_api_key

# --- infisical — gestor de secretos para consumo entre máquinas (mejora 16,
# docs/22-mejoras-futuras.md; despliegue completo en docs/26-infisical-secretos.md,
# decisión de mecanismo de inyección en docs/adr/0001-infisical-inyeccion-bind-mount-vs-imagen-derivada.md,
# decisión de Postgres dedicado en docs/adr/0002-infisical-postgres-dedicado.md) ---
# Contraseña del usuario/base "infisical" en el contenedor postgres-infisical
# (Postgres DEDICADO, NO postgres-main — ver ADR 0002), creados automáticamente
# por la propia imagen oficial al arrancar (POSTGRES_USER/POSTGRES_DB). Generar
# con "openssl rand -hex 24" (a propósito hex, no base64: evita caracteres
# especiales que necesitarían percent-encoding en el DSN de abajo).
INFISICAL_POSTGRES_PASSWORD=CHANGE_ME_hex_password
# Por nombre de contenedor (misma red retaco-net) — usa el MISMO valor que
# INFISICAL_POSTGRES_PASSWORD de arriba.
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:CHANGE_ME_hex_password@postgres-infisical:5432/infisical
# Usuario Valkey dedicado (retaco/config/valkey/users.acl, prefijo
# infisical:*) — TLS obligatorio (Valkey no acepta puerto en claro), por eso
# "rediss://" y el hostname valkey.home.arpa (el certificado de Valkey solo
# lleva ese CN/SAN, no el nombre de contenedor "valkey" — docs/25-valkey-cache.md).
INFISICAL_REDIS_URL=rediss://infisical:CHANGE_ME_valkey_acl_password@valkey.home.arpa:6379
# openssl rand -hex 16 (16 bytes) — NUNCA rotar sin plan de migración: cifra
# todos los secretos ya guardados, cambiarlo a ciegas los deja ilegibles.
INFISICAL_ENCRYPTION_KEY=CHANGE_ME_16_byte_hex
# openssl rand -base64 32
INFISICAL_AUTH_SECRET=CHANGE_ME_32_byte_base64
# CIDR de nginx (pi-dns), único reverse proxy delante de Infisical — evita
# que cualquiera pueda falsificar X-Forwarded-For y suplantar una IP cliente.
INFISICAL_TRUSTED_PROXY_CIDRS=192.168.1.170/32

# --- authentik — SSO/authn para personas (mejora 25, docs/22-mejoras-futuras.md;
# despliegue completo en docs/27-authentik-sso.md) ---
# Machine Identity "authentik" en Infisical (Universal Auth) — el propio CLI
# resuelve la contraseña de Postgres y AUTHENTIK_SECRET_KEY en el arranque,
# no van en claro aquí. Client ID/Secret: Infisical → Organization Access
# Control → Machine Identities → authentik → Universal Auth.
AUTHENTIK_INFISICAL_CLIENT_ID=CHANGE_ME_infisical_universal_auth_client_id
AUTHENTIK_INFISICAL_CLIENT_SECRET=CHANGE_ME_infisical_universal_auth_client_secret
# Project ID de Infisical (no es secreto) — mismo proyecto "Homelab Cluster"
# que el resto de servicios migrados.
AUTHENTIK_INFISICAL_PROJECT_ID=CHANGE_ME_infisical_project_id
