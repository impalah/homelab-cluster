# =============================================================================
# retaco/.env.example
# Copiar a /srv/homelab/retaco/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- PostgreSQL (postgres-main) — cuenta de administración del servidor ---
# Superusuario del servidor Postgres. NO la usa ninguna app directamente —
# es solo para tareas de gestión (crear nuevas bases de datos con
# shared/scripts/create-postgres-db.sh, backups, etc.).
POSTGRES_ADMIN_USER=dbadmin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_strong_postgres_admin_password

# --- PostgreSQL — base de datos y usuario propios de n8n ---
# Aislados: n8n solo puede ver/tocar su propia base de datos, no las de
# otros proyectos que añadas más adelante (ver docs/05-instalacion-retaco.md).
# Si vienes de migrar ryzen, usa los MISMOS valores que tenía
# ryzen/.env → N8N_DB_NAME/N8N_DB_USER/N8N_DB_PASSWORD, para que n8n-main
# siga viendo su base de datos existente sin tener que reconfigurar nada.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_strong_n8n_db_password

# --- n8n-main ---
# Si vienes de migrar ryzen: usa los MISMOS valores que tenía ryzen/.env,
# especialmente N8N_ENCRYPTION_KEY — cambiarla haría ILEGIBLES todas las
# credenciales ya guardadas en workflows existentes (irreversible, ver
# docs/05-instalacion-retaco.md).
N8N_ENCRYPTION_KEY=CHANGE_ME_32_char_random_hex_key_here
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_HOST=n8n.home.arpa
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.home.arpa/
GENERIC_TIMEZONE=Europe/Madrid

# --- Qdrant ---
# Si vienes de migrar ryzen, usa los MISMOS valores que tenía ryzen/.env,
# para no tener que actualizar credenciales en n8n ni en ningún otro cliente
# — ver docs/05-instalacion-retaco.md sección de migración.
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key_32chars
QDRANT_READONLY_KEY=CHANGE_ME_qdrant_readonly_key

# --- Registry (registro Docker privado) ---
# Solo el HTTP secret va aquí — el usuario/contraseña de docker login vive
# en /srv/homelab/retaco/registry/auth/htpasswd (bcrypt, no en texto plano
# en ningún .env). Ver docs/05-instalacion-retaco.md.
REGISTRY_HTTP_SECRET=CHANGE_ME_random_hex_secret

# --- epub2pdf-service / pdf2chunks-service ---
# Todas opcionales, con default razonable en docker-compose.yml si no se
# definen aquí — solo hace falta tocarlas para cambiar el comportamiento por
# defecto. Ver docs/05-instalacion-retaco.md sección 5.4 y el README de cada
# servicio (services/epub2pdf-service/, services/pdf2chunks-service/).
EPUB2PDF_LOG_LEVEL=INFO
EPUB2PDF_CONVERSION_TIMEOUT_SECONDS=300
PDF2CHUNKS_LOG_LEVEL=INFO
PDF2CHUNKS_OCR_CHAR_THRESHOLD=20
PDF2CHUNKS_OCR_LANGUAGE=eng
PDF2CHUNKS_CHUNK_SIZE_TOKENS=400
PDF2CHUNKS_CHUNK_OVERLAP_RATIO=0.15
PDF2CHUNKS_CHUNKING_STRATEGY=fixed_size
PDF2CHUNKS_OUTPUT_FORMAT=json
