# =============================================================================
# pi-dns/.env.example
# Copiar a /srv/homelab/pi-dns/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- Pi-hole ---
PIHOLE_PASSWORD=CHANGE_ME_pihole_admin_password
PIHOLE_DNS_1=172.20.0.2#5335
PIHOLE_DNSSEC=false
VIRTUAL_HOST=pi-dns.home.arpa
TZ=Europe/Madrid

# --- apikey-service ---
# Migrado a Infisical (mejora 16, docs/26-infisical-secretos.md) — YA NO lleva
# APIKEY_DATABASE_URL/APIKEY_ADMIN_TOKEN en claro aquí. Ambos secretos viven en
# Infisical (proyecto "Homelab Cluster", entorno prod, raíz) y se inyectan en
# el arranque del contenedor vía el wrapper de dos pasos "infisical login
# --method=universal-auth" + "infisical run --token=..." — ver el bloque
# apikey-service en docker-compose.yml y el ADR 0001. Lo único que queda aquí
# son las credenciales de la Machine Identity (alcance mínimo: solo lectura,
# solo este proyecto/entorno) — sigue siendo un secreto, pero uno solo, en
# vez de N secretos de aplicación.
# Client ID/Secret: Infisical → Organization Access Control → Machine
# Identities → apikey-service → Universal Auth.
APIKEY_SERVICE_INFISICAL_CLIENT_ID=CHANGE_ME_infisical_universal_auth_client_id
APIKEY_SERVICE_INFISICAL_CLIENT_SECRET=CHANGE_ME_infisical_universal_auth_client_secret
# Project ID de Infisical (no es secreto, pero se parametriza igual — visible
# en la URL del proyecto o via GET /api/v1/workspace autenticado).
APIKEY_SERVICE_INFISICAL_PROJECT_ID=CHANGE_ME_infisical_project_id

# --- Infisical: Machine Identity 'acme-dns-renewer' (mejora 32) ---
# Usada por shared/scripts/renew-letsencrypt.sh (cron en este nodo) para leer
# las credenciales AWS (dns_aws de acme.sh, reto DNS-01 contra la hosted zone
# Route53 de 404labo.net) desde /acme-dns-renewer/ del mismo proyecto de
# arriba — mismo patrón, Machine Identity propia con Universal Auth.
ACME_RENEWER_INFISICAL_CLIENT_ID=CHANGE_ME_infisical_universal_auth_client_id
ACME_RENEWER_INFISICAL_CLIENT_SECRET=CHANGE_ME_infisical_universal_auth_client_secret
ACME_RENEWER_INFISICAL_PROJECT_ID=CHANGE_ME_infisical_project_id

# --- Tailscale (subnet router — acceso remoto autenticado a la LAN) ---
# Generar en https://login.tailscale.com/admin/settings/keys → Generate auth key
# → "Reusable" activado, "Ephemeral" DESACTIVADO (este nodo debe seguir
# registrado tras el primer arranque, no desaparecer del tailnet). Caduca a
# los 90 días por defecto — si el contenedor pierde su volumen de estado
# después de esa fecha, hace falta generar una key nueva. Ver docs/18-tailscale.md.
TS_AUTHKEY=CHANGE_ME_tskey-auth-xxxxx

# --- NUT (Network UPS Tools) -- cliente que monitoriza el SAI remoto en pi-obs ---
# Mismo valor que NUT_MONUSER_PASSWORD en pi-obs/.env -- ver docs/33-nut-sai.md
NUT_MONUSER_PASSWORD=CHANGE_ME_nut_monuser_password
