# =============================================================================
# pi-dns/.env.example
# Copiar a /srv/homelab/pi-dns/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- Pi-hole ---
PIHOLE_PASSWORD=CHANGE_ME_pihole_admin_password
PIHOLE_DNS_1=172.20.0.2#5335
PIHOLE_DNSSEC=false
VIRTUAL_HOST=pi-dns.home.arpa
TZ=Europe/Madrid

# --- apikey-service ---
# Base de datos aislada en postgres-main (retaco), creada con:
#   bash shared/scripts/create-postgres-db.sh postgres-main <admin> apikeys apikeys
# Ver docs/06-instalacion-pi1-dns.md
APIKEY_DATABASE_URL=postgresql+asyncpg://apikeys:CHANGE_ME@192.168.1.174:5432/apikeys
# Token de administración — protege POST/GET/DELETE /keys (creación/listado/
# revocado de API keys). Nunca protege /validate, que usa nginx internamente.
APIKEY_ADMIN_TOKEN=CHANGE_ME_admin_token_largo_y_aleatorio

# --- Tailscale (subnet router — acceso remoto autenticado a la LAN) ---
# Generar en https://login.tailscale.com/admin/settings/keys → Generate auth key
# → "Reusable" activado, "Ephemeral" DESACTIVADO (este nodo debe seguir
# registrado tras el primer arranque, no desaparecer del tailnet). Caduca a
# los 90 días por defecto — si el contenedor pierde su volumen de estado
# después de esa fecha, hace falta generar una key nueva. Ver docs/18-tailscale.md.
TS_AUTHKEY=CHANGE_ME_tskey-auth-xxxxx
