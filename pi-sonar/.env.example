# =============================================================================
# pi-sonar/.env.example
# Copiar a /srv/homelab/pi-sonar/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- PostgreSQL — credenciales de aplicación para conectar a postgres-main en retaco ---
# La base de datos ya no vive en este nodo (ver docs/05-instalacion-retaco.md)
# — estas son solo las credenciales que usa SonarQube para conectarse
# cross-host a postgresql.home.arpa. Deben coincidir con las creadas en
# retaco con create-postgres-db.sh.
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=CHANGE_ME_sonarqube_db_password
SONARQUBE_DB_NAME=sonarqube

# --- SonarQube JVM (ajustado para Raspberry Pi 5, 8 GB RAM) ---
SONAR_WEB_JAVAOPTS=-Xmx512m -Xms128m
SONAR_CE_JAVAOPTS=-Xmx512m -Xms128m
SONAR_SEARCH_JAVAOPTS=-Xmx1g -Xms1g -XX:MaxDirectMemorySize=256m

# --- URL pública ---
SONAR_CORE_SERVERBASEURL=https://sonarqube.home.arpa

# --- Zona horaria ---
TZ=Europe/Madrid

# --- bifrost — gateway LLM (AWS Bedrock) — ver docs/23-bifrost-gateway-llm.md ---
# Credenciales del usuario IAM BASE "bifrost-bedrock-base" — SIN permiso de
# Bedrock por sí mismo, solo sts:AssumeRole sobre AWS_ROLE_ARN. Bifrost hace
# el assume-role internamente (bedrock_key_config.role_arn en config.json) y
# renueva la sesión temporal solo — estas dos claves nunca llaman a Bedrock
# directamente, solo abren la puerta al rol.
AWS_ACCESS_KEY_ID=CHANGE_ME_access_key_del_usuario_base
AWS_SECRET_ACCESS_KEY=CHANGE_ME_secret_key_del_usuario_base
AWS_ROLE_ARN=arn:aws:iam::CHANGE_ME_ID_DE_CUENTA_AWS:role/bifrost-bedrock-invoke
AWS_REGION=eu-west-1

# Virtual key propia de Bifrost (no es una credencial de AWS) — la que deben
# usar Open WebUI/n8n como cabecera "Authorization: Bearer <valor>" o
# "x-bf-vk: <valor>" al llamar a bifrost.home.arpa. Generar con:
#   openssl rand -hex 24
# y anteponer el prefijo "sk-bf-" por convención del propio proyecto.
BIFROST_VIRTUAL_KEY=CHANGE_ME_bifrost_virtual_key

# Panel/API de administración de Bifrost (logs, coste, gobernanza) — sin
# esto queda sin autenticación, ver docs/23-bifrost-gateway-llm.md.
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=CHANGE_ME_bifrost_admin_password
