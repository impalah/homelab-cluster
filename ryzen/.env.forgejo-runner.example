# Mejora 7.3 (docs/22-mejoras-futuras.md): runner de Forgejo Actions manual
# en ryzen. Copiar a `.env.forgejo-runner` (NUNCA versionado) con los valores
# reales -- obtenidos al registrar este runner en Forgejo (una sola vez,
# idempotente, hecho ya en vivo el 2026-09-04 desde dentro del contenedor
# `forgejo` en pinchi):
#
#   docker exec <contenedor-forgejo> forgejo forgejo-cli actions register \
#     --name forgejo-runner-ryzen --secret <40 caracteres hexadecimales>
#
# El comando imprime el UUID resultante por stdout -- ese valor y el mismo
# secreto usado van aquí debajo. Ver docker-compose.forgejo-runner.yml para
# cómo se consumen (env_file, sin Infisical a propósito en este runner).

FORGEJO_RUNNER_UUID=CHANGE_ME
FORGEJO_RUNNER_TOKEN=CHANGE_ME
