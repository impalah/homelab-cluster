# =============================================================================
# ryzen/.env.example
# Copiar a /srv/homelab/ryzen/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- Whisper-service ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es

# --- Ollama ---
OLLAMA_ORIGINS=*

# --- Open-WebUI ---
OPENWEBUI_SECRET_KEY=CHANGE_ME_openwebui_secret_key

# --- vLLM (alterna con ollama, ver docs/07-instalacion-ryzen.md) ---
# Checkpoint por defecto: Qwen3-14B, GPTQ W4A16 (RedHatAI). Alternativa
# documentada: RedHatAI/gemma-3-12b-it-quantized.w4a16
VLLM_MODEL=RedHatAI/Qwen3-14B-quantized.w4a16
VLLM_SERVED_NAME=qwen3-14b
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=8192
# Solo necesario si el checkpoint elegido es gated en Hugging Face
HUGGING_FACE_HUB_TOKEN=

# --- ComfyUI (alterna con whisper-service en GPU 1, ver docs/07-instalacion-ryzen.md) ---
# Vacío por defecto. Ejemplo de uso: --lowvram (fuerza modo de bajo consumo
# de VRAM, útil si cargas checkpoints SDXL en vez de SD1.5/Turbo/LCM).
COMFYUI_CLI_ARGS=
