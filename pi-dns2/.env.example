# pi-dns2 -- DNS de respaldo (mejora 55). Copiar a .env en el nodo (nunca al repo).
TZ=Europe/Madrid

# Misma contraseña de la API/panel de Pi-hole que pi-dns: así load-dns-records.sh
# aplica los registros a los dos con una sola variable.
PIHOLE_PASSWORD=CHANGE_ME_pihole_password

# Upstream: el Unbound local (valor por defecto, rara vez hay que tocarlo)
PIHOLE_DNS_1=172.20.0.2#5335
PIHOLE_DNSSEC=false
VIRTUAL_HOST=pi-dns2.404labo.net

# Cliente NUT: la misma que NUT_MONUSER_PASSWORD de pi-dns/.env (docs/33-nut-sai.md)
NUT_MONUSER_PASSWORD=CHANGE_ME_nut_monuser_password
