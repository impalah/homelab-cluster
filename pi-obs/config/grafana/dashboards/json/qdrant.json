      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "id",
            "renamePattern": "coleccion"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "collection",
            "renamePattern": "coleccion"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "coleccion",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "instance 1": true,
              "instance 2": true,
              "job 1": true,
              "job 2": true,
              "node 1": true,
              "node 2": true
            },
            "renameByName": {
              "coleccion": "Colección",
              "Value #A": "Puntos",
              "Value #B": "Vectores"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
