# =============================================================================
# pi-obs/.env.example
# Copiar a /srv/homelab/pi-obs/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GF_SERVER_ROOT_URL=https://grafana.home.arpa
GF_SERVER_DOMAIN=grafana.home.arpa

# --- PostgreSQL exporter ---
# postgres-main vive en el nodo retaco (192.168.1.174), no en ryzen — ver
# docs/05-instalacion-retaco.md. Usuario/contraseña deben coincidir con
# N8N_DB_USER/N8N_DB_PASSWORD de retaco/.env — NO con
# POSTGRES_ADMIN_USER/PASSWORD (esa es la cuenta de administración, no debe
# usarla ningún exporter ni aplicación).
POSTGRES_EXPORTER_DSN=postgresql://n8n:CHANGE_ME_strong_postgres_password@192.168.1.174:5432/n8n?sslmode=disable

# --- Prometheus ---
PROMETHEUS_RETENTION_TIME=30d

# --- Zona horaria ---
TZ=Europe/Madrid
