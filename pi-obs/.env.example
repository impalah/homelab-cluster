# =============================================================================
# pi-obs/.env.example
# Copiar a /srv/homelab/pi-obs/.env y ajustar todos los valores CHANGE_ME
# =============================================================================

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GF_SERVER_ROOT_URL=https://grafana.home.arpa
GF_SERVER_DOMAIN=grafana.home.arpa

# --- PostgreSQL exporter ---
# postgres-main vive en el nodo retaco (192.168.1.174), no en ryzen — ver
# docs/05-instalacion-retaco.md. Usa un rol de monitorización DEDICADO
# ("postgres_exporter", creado a mano — ver esa misma sección), NO el
# usuario de ninguna aplicación (n8n, sonarqube, apikeys...) ni
# POSTGRES_ADMIN_USER/PASSWORD (la cuenta de administración). Las bases de
# datos de aplicación están aisladas entre sí (REVOKE ALL ... FROM PUBLIC,
# ver create-postgres-db.sh) — reutilizar las credenciales de una app
# concreta como si fuera el exporter deja sin permisos para ver el tamaño
# del resto de bases ni las métricas de WAL (permission denied en el log
# de postgres-main), aunque el exporter siga funcionando en apariencia.
POSTGRES_EXPORTER_DSN=postgresql://postgres_exporter:CHANGE_ME_strong_postgres_password@192.168.1.174:5432/postgres?sslmode=disable

# --- Prometheus ---
PROMETHEUS_RETENTION_TIME=30d

# --- NUT (Network UPS Tools) -- SAI Salicru SPS 2200 SOHO+, USB en este nodo ---
# monuser: el que usan upsmon remotos de los otros 5 nodos + el nut_exporter
# de Prometheus para leer estado. admin: solo para gestión manual (upsc -c).
# Ver docs/33-nut-sai.md.
NUT_MONUSER_PASSWORD=CHANGE_ME_nut_monuser_password
NUT_ADMIN_PASSWORD=CHANGE_ME_nut_admin_password

# --- Zona horaria ---
TZ=Europe/Madrid
