# =============================================================================
# Configuración SSH del puesto de trabajo (ryzen) para los 8 nodos del clúster.
# Mejora 52, docs/38-acceso-ssh-nodos.md. Se usa con:
#
#   # ~/.ssh/config
#   Include /home/linus/projects/local-ia/homelab-cluster/shared/config/ssh/homelab_ssh_config
#
# Hace que `ssh admin@192.168.10.7` (y `ssh retaco`) elija la clave PROPIA de
# ese nodo, sin que los scripts de shared/scripts/ tengan que saber de claves.
# - Las claves viven en Infisical (proyecto ssh-access); la copia local de
#   ~/claves-temporales/<nodo>-id_ed25519 es el respaldo. Si solo existe el
#   .pub, ssh usa la clave cargada en el ssh-agent (ssh-node.sh la carga).
# - El segundo IdentityFile (~/.ssh/id_ed25519) es la clave compartida antigua:
#   solo sirve para entrar con las cuentas antiguas u-<x> mientras sigan vivas.
# =============================================================================

Host pi-dns 192.168.10.2
  HostName 192.168.10.2
  User admin
  IdentityFile ~/claves-temporales/pi-dns-id_ed25519
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

