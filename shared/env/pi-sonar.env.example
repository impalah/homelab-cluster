# =============================================================================
# pi-sonar.env.example — Variables de entorno para el nodo pi-sonar
# Copiar a /srv/homelab/pi-sonar/.env y ajustar valores antes del primer arranque.
# =============================================================================

# --- PostgreSQL (sonarqube-db) ---
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=CHANGE_ME_sonarqube_db_password
SONARQUBE_DB_NAME=sonarqube

# --- SonarQube ---
# JVM heap settings para Raspberry Pi 5 (8 GB RAM)
SONAR_WEB_JAVAOPTS=-Xmx512m -Xms128m
SONAR_CE_JAVAOPTS=-Xmx512m -Xms128m
SONAR_SEARCH_JAVAOPTS=-Xmx1g -Xms512m -XX:MaxDirectMemorySize=256m
# URL pública de SonarQube (usada por el escáner y notificaciones)
SONAR_WEB_CONTEXT=/
SONAR_CORE_SERVERBASEURL=https://sonarqube.home.arpa

# --- Zona horaria ---
TZ=Europe/Madrid
