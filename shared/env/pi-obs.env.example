# =============================================================================
# pi-obs.env.example — Variables de entorno para el nodo pi-obs
# Copiar a /srv/homelab/pi-obs/.env y ajustar valores antes del primer arranque.
# =============================================================================

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GF_SERVER_ROOT_URL=https://grafana.home.arpa
GF_SERVER_DOMAIN=grafana.home.arpa

# --- PostgreSQL exporter (conecta a postgres-main en Ryzen) ---
# Formato: postgresql://usuario:contraseña@host:puerto/base-de-datos?sslmode=disable
POSTGRES_EXPORTER_DSN=postgresql://n8n:CHANGE_ME_strong_postgres_password@192.168.1.150:5432/n8n?sslmode=disable

# --- Prometheus ---
PROMETHEUS_RETENTION_TIME=30d

# --- Loki ---
LOKI_RETENTION_PERIOD=336h

# --- Tempo ---
TEMPO_RETENTION=72h

# --- OTel Collector ---
# Sin variables adicionales; configuración en otel-collector.yaml

# --- Zona horaria ---
TZ=Europe/Madrid
