# =============================================================================
# ryzen.env.example — Variables de entorno para el nodo Ryzen 9
# Copiar a /srv/homelab/ryzen/.env y ajustar valores antes del primer arranque.
# =============================================================================

# --- PostgreSQL (postgres-main) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=n8n

# --- n8n-main ---
N8N_ENCRYPTION_KEY=CHANGE_ME_32_char_random_hex_key_here
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_HOST=n8n.home.arpa
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.home.arpa/
GENERIC_TIMEZONE=Europe/Madrid

# --- Qdrant ---
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key_32chars
QDRANT_READONLY_KEY=CHANGE_ME_qdrant_readonly_key

# --- Whisper-service ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es

# --- Ollama ---
# (no requiere autenticación por defecto en red interna)
OLLAMA_ORIGINS=*

# --- Open-WebUI ---
OPENWEBUI_SECRET_KEY=CHANGE_ME_openwebui_secret_key
# URL del backend Ollama (acceso vía red Docker interna)
OLLAMA_BASE_URL=http://ollama:11434
