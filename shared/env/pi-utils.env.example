# =============================================================================
# pi-utils.env.example — Variables de entorno para el nodo pi-utils
# Copiar a /srv/homelab/pi-utils/.env y ajustar valores antes del primer arranque.
# =============================================================================

# --- n8n-aux (instancia secundaria) ---
N8N_AUX_ENCRYPTION_KEY=CHANGE_ME_32_char_random_hex_key_aux
N8N_AUX_BASIC_AUTH_ACTIVE=true
N8N_AUX_BASIC_AUTH_USER=admin
N8N_AUX_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_aux_password
N8N_AUX_HOST=n8n-aux.home.arpa
N8N_AUX_PORT=5679
N8N_AUX_PROTOCOL=https
N8N_AUX_WEBHOOK_URL=https://n8n-aux.home.arpa/
GENERIC_TIMEZONE=Europe/Madrid

# --- RSSHub ---
# Clave de acceso opcional para restringir el acceso público
RSSHUB_ACCESS_KEY=CHANGE_ME_rsshub_access_key
# Tiempo de caché de feeds en segundos (default: 300 = 5 min)
RSSHUB_CACHE_EXPIRE=300

# --- markitdown-service ---
# Puerto en el que escucha el servicio
MARKITDOWN_PORT=8001
# Nivel de log: DEBUG | INFO | WARNING | ERROR
MARKITDOWN_LOG_LEVEL=INFO

# --- Zona horaria ---
TZ=Europe/Madrid
