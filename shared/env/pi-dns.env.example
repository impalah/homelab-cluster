# =============================================================================
# pi-dns.env.example — Variables de entorno para el nodo pi-dns
# Copiar a /srv/homelab/pi-dns/.env y ajustar valores antes del primer arranque.
# =============================================================================

# --- Pi-hole ---
PIHOLE_PASSWORD=CHANGE_ME_pihole_admin_password
# IP de la interfaz LAN donde escucha Pi-hole
PIHOLE_SERVER_IP=192.168.1.170
# Zona horaria
TZ=Europe/Madrid
# Upstream DNS interno (Unbound)
PIHOLE_DNS_1=127.0.0.1#5335
PIHOLE_DNS_2=
# Deshabilitar DNSSEC en Pi-hole (Unbound ya lo gestiona)
PIHOLE_DNSSEC=false
# Nombre de host de la interfaz web
VIRTUAL_HOST=pi-dns.home.arpa

# nginx no requiere variables de entorno: el certificado TLS se genera con
# config/nginx/generate-cert.sh (validez larga, ver README de este nodo)
