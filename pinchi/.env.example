# =============================================================================
# pinchi/.env.example
# Copiar a /srv/homelab/pinchi/.env y ajustar el valor CHANGE_ME
# =============================================================================

# --- NUT (Network UPS Tools) -- cliente que monitoriza el SAI remoto en pi-obs ---
# Mismo valor que NUT_MONUSER_PASSWORD en pi-obs/.env -- ver docs/33-nut-sai.md
NUT_MONUSER_PASSWORD=CHANGE_ME_nut_monuser_password

# --- Zona horaria ---
TZ=Europe/Madrid

# --- Forgejo Actions: runner por defecto, siempre en ejecución (mejora 7.3) ---
# Obtenidos al registrar el runner en Forgejo (una sola vez, idempotente):
#   docker exec <contenedor-forgejo> forgejo forgejo-cli actions register \
#     --name forgejo-runner-pinchi --secret <40 caracteres hexadecimales>
# El comando imprime el UUID resultante por stdout.
FORGEJO_RUNNER_UUID=CHANGE_ME
FORGEJO_RUNNER_TOKEN=CHANGE_ME
